generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Schema generated by Better-auth: User, Session, Account, Verification
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  blogPosts    BlogPost[]

  role String

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Project model
model Project {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  clientName       String
  hideClientName   Boolean        @default(false)
  shortDescription String         @db.Text
  longDescription  String         @db.Text
  problem          String?        @db.Text
  solution         String?        @db.Text
  images           ProjectImage[]
  technologies     Technology[]
  duration         Int // in days
  teamSize         Int
  budget           Float?
  metrics          String?        @db.Text
  status           ProjectStatus  @default(COMPLETED)
  featured         Boolean        @default(false)
  order            Int            @default(0)
  testimonial      Testimonial[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// Project images
model ProjectImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Technologies
model Technology {
  id        String       @id @default(cuid())
  name      String       @unique
  category  TechCategory
  logo      String?
  projects  Project[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// Client feedbacks
model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  clientRole String
  company    String
  content    String   @db.Text
  photo      String?
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Contact requests
model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String        @db.Text
  budget    String?
  reply     String?      @db.Text
  replyAt   DateTime?
  status    ContactStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// Website settings
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Blog
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title      String
  excerpt    String?   @db.Text
  content    String    @db.Text
  coverImage String?
  category   String
  tags       String[]
  published Boolean   @default(false)
  featured   Boolean   @default(false)
  views      Int       @default(0)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([category])
  @@index([published])
  @@map("blog_post")
}

// Enums
enum ProjectStatus {
  IN_PROGRESS
  COMPLETED
  FEATURED
}

enum BlogCategory {
  ENTREPRISE
  TECHNOLOGIE
  PROJETS
  CARRIERES
  EVENEMENTS
}

enum TechCategory {
  FRONTEND
  BACKEND
  MOBILE
  DATABASE
  DEVOPS
  DESIGN
  OTHER
}

enum ContactStatus {
  UNREAD
  READ
  AWAITING
  ARCHIVED
}
